<mjml>
  <mj-head>
    <mj-font
      name="Poppins"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
    />
    <mj-font
      name="Source Code Pro"
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@600&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Poppins, Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#ffffff" line-height="1.6" padding="0" />
      <mj-section padding="0" background-color="#191131" />
      <mj-button
        background-color="#f89b41"
        color="#191131"
        font-size="14px"
        font-weight="600"
        border-radius="4px"
        inner-padding="10px 40px"
      />
    </mj-attributes>
    <mj-style>
      a {
        color: #f89b41;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      b {
        color: #ffffff;
      }
      .email-container > table > tbody > tr > td {
        border-radius: 32px;
        overflow: hidden;
      }
      .footer-section > table {
        border-radius: 0 0 32px 32px;
        border-left: 2px solid #191131;
        border-right: 2px solid #191131;
        border-top: 2px solid #191131;
        overflow: hidden;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0d0526">
    <mj-wrapper background-color="#0d0526" padding="0" css-class="email-container">
      <mj-include path="header.mjml" />
      <mj-include path="greeting.mjml" />
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >The token for the service account
            <b>{{ service_account_name }}</b> in the
            <b>{{ workspace_name }}</b> workspace was regenerated by
            {{ regenerated_by }}. The old token no longer works.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >Anything still using the old token, such as a CI pipeline, will
            fail until it's given the new one. If you didn't expect this,
            regenerate the token again or delete the service account right
            away.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="20px 40px 10px 40px">
        <mj-column>
          <mj-button href="{{ service_account_url }}"
            >View Service Account</mj-button
          >
          <mj-text
            font-size="11px"
            align="center"
            color="#9990a8"
            padding="5px 0 0 0"
          >
            {{ service_account_url }}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-include path="discord-cta.mjml" />
      <mj-include path="footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
