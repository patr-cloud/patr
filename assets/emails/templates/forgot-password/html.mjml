<mjml>
  <mj-head>
    <mj-font
      name="Poppins"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
    />
    <mj-font
      name="Source Code Pro"
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@600&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Poppins, Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#ffffff" line-height="1.6" padding="0" />
      <mj-section padding="0" background-color="#191131" />
      <mj-button
        background-color="#f89b41"
        color="#191131"
        font-size="14px"
        font-weight="600"
        border-radius="4px"
        inner-padding="10px 40px"
      />
    </mj-attributes>
    <mj-style>
      a {
        color: #f89b41;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      b {
        color: #ffffff;
      }
      .email-container > table > tbody > tr > td {
        border-radius: 32px;
        overflow: hidden;
      }
      .footer-section > table {
        border-radius: 0 0 32px 32px;
        border-left: 2px solid #191131;
        border-right: 2px solid #191131;
        border-top: 2px solid #191131;
        overflow: hidden;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0d0526">
    <mj-wrapper background-color="#0d0526" padding="0" css-class="email-container">
      <mj-include path="header.mjml" />
      <mj-include path="greeting.mjml" />
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text>Your password reset code is:</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="20px 20px 10px 20px">
        <mj-column border="1px solid #f89b41" border-radius="4px" padding="0">
          <mj-text
            align="center"
            font-family="'Source Code Pro', monospace"
            font-size="28px"
            font-weight="600"
            color="#f89b41"
            padding="15px"
            >{{ otp_code }}</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >This code expires in <b>{{ otp_expiry }}</b
            >. Enter it on the password reset page to set a new password. You
            can also click the button below to go directly to the password reset
            page:</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px">
        <mj-column>
          <mj-button
            href="https://app.patr.cloud/reset-password?email={{ email }}&amp;code={{ otp_code }}"
            >Reset Password</mj-button
          >
          <mj-text
            font-size="11px"
            align="center"
            color="#9990a8"
            padding="5px 0 0 0"
          >
            https://app.patr.cloud/reset-password?email={{ email }}&amp;code={{
              otp_code
            }}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >If you didn't request this, your account may be at risk. Change
            your password immediately and contact us on
            <a href="https://patr.cloud/discord" style="color: #f89b41"
              >Discord</a
            >.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-include path="discord-cta.mjml" />
      <mj-include path="footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
