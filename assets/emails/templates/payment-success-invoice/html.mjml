<mjml>
  <mj-head>
    <mj-font
      name="Poppins"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
    />
    <mj-font
      name="Source Code Pro"
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@600&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Poppins, Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#ffffff" line-height="1.6" padding="0" />
      <mj-section padding="0" background-color="#191131" />
      <mj-button
        background-color="#f89b41"
        color="#191131"
        font-size="14px"
        font-weight="600"
        border-radius="4px"
        inner-padding="10px 40px"
      />
    </mj-attributes>
    <mj-style>
      a {
        color: #f89b41;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      b {
        color: #ffffff;
      }
      .email-container > table > tbody > tr > td {
        border-radius: 32px;
        overflow: hidden;
      }
      .footer-section > table {
        border-radius: 0 0 32px 32px;
        border-left: 2px solid #191131;
        border-right: 2px solid #191131;
        border-top: 2px solid #191131;
        overflow: hidden;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0d0526">
    <mj-wrapper background-color="#0d0526" padding="0" css-class="email-container">
      <mj-include path="header.mjml" />
      <mj-include path="greeting.mjml" />
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >Your invoice for <b>{{ bill_month }} {{ bill_year }}</b> on
            workspace <b>{{ workspace_name }}</b> is ready.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            ><b>Total charges:</b> ${{ total_charge }}</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >A detailed breakdown of your usage is included below.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >Payment was handled automatically - no action needed. Here's how it
            was covered:</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text padding="0 0 5px 0"
            >&#8226; <b>Card:</b> ${{ card_amount_deducted }}</mj-text
          >
          <mj-text
            >&#8226; <b>Credits:</b> ${{ credits_deducted }} (remaining:
            ${{ credits_remaining }})</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >You can view the full invoice in the billing section.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px">
        <mj-column>
          <mj-button href="https://app.patr.cloud/billing"
            >View Invoice</mj-button
          >
          <mj-text
            font-size="11px"
            align="center"
            color="#9990a8"
            padding="5px 0 0 0"
          >
            https://app.patr.cloud/billing
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-include path="discord-cta.mjml" />
      <mj-include path="footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
