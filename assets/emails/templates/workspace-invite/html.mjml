<mjml>
  <mj-head>
    <mj-font
      name="Poppins"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Poppins, Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#ffffff" line-height="1.6" padding="0" />
      <mj-section padding="0" background-color="#191131" />
      <mj-button
        background-color="#f89b41"
        color="#191131"
        font-size="14px"
        font-weight="600"
        border-radius="4px"
        inner-padding="10px 40px"
      />
    </mj-attributes>
    <mj-style>
      a {
        color: #f89b41;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      b {
        color: #ffffff;
      }
      .email-container > table > tbody > tr > td {
        border-radius: 32px;
        overflow: hidden;
      }
      .footer-section > table {
        border-radius: 0 0 32px 32px;
        border-left: 2px solid #191131;
        border-right: 2px solid #191131;
        border-top: 2px solid #191131;
        overflow: hidden;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0d0526">
    <mj-wrapper background-color="#0d0526" padding="0" css-class="email-container">
      <mj-include path="header.mjml" />
      <mj-section padding="30px 40px 0 40px">
        <mj-column>
          <mj-text font-size="18px" font-weight="700" color="#ffffff"
            >You've been invited to <b>{{ workspace_name }}</b></mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            ><b>{{ invited_by }}</b> has invited you to join the
            <b>{{ workspace_name }}</b> workspace on Patr. Click the button below
            to accept the invite. If you don't have a Patr account yet, you'll be
            able to create one first.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="20px 40px 10px 40px">
        <mj-column>
          <mj-button
            href="{{ accept_url }}"
            >Accept Invite</mj-button
          >
          <mj-text
            font-size="11px"
            align="center"
            color="#9990a8"
            padding="10px 0 0 0"
          >
            {{ accept_url }}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >This invite will expire in <b>{{ expiry }}</b>.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="10px 40px 0 40px">
        <mj-column>
          <mj-text
            >If you weren't expecting this invite, you can safely ignore this
            email. If you have any questions or need assistance, please contact
            our support team at
            <a href="mailto:support@patr.cloud" style="color: #f89b41"
              >support@patr.cloud</a
            >.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-include path="discord-cta.mjml" />
      <mj-include path="footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
