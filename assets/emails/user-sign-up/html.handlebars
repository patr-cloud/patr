{{#> container}}
{{#*inline "email-content"}}
<tr>
  <td style="
      padding-top: 1rem;
      padding-bottom: 1.5rem;
      color: #ffffff;
      letter-spacing: 0.3px;
      line-height: 1.3;
      font-weight: 300;
    ">
    Enter the code below to verify your email address and complete your Patr sign-up:
  </td>
</tr>
<tr>
  <td style="
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
      text-align: center;
      border: 1px solid #f89b41;
      border-radius: 0.25rem;
      -webkit-border-radius: 0.25rem;
      -moz-border-radius: 0.25rem;
    " align="center">
    <strong style="
      color: #f89b41;
      font-size: 2rem;
      ">{{#if
      otp}}{{otp}}{{else}}123-456{{/if}}</strong>
  </td>
</tr>
<tr>
  <td style="
    padding-top: 1.5rem;
    text-align: center;
    " align="center">
    <strong style="
      color: #fff;
      font-size: 1rem;
      font-weight: 300;
      ">
      Or click the button below:
    </strong>
  </td>
</tr>
<tr>
  <td style="
    text-align: center;
    padding-top: 1rem
    " align="center">
    <a href="https://app.patr.cloud/sign-up/confirm?otp={{otp}}&username={{username}}" style="
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        text-align: center;
        vertical-align: middle;
        padding-left: 3rem;
        padding-right: 3rem;
        color: #0d0526;
        background-color: #f89b41;
        border-radius: 0.25rem;
        -webkit-border-radius: 0.25rem;
        -moz-border-radius: 0.25rem;
        text-decoration: none;
        font-weight: 500;
      ">
      Verify Email
    </a>
  </td>
</tr>
<tr>

  <td style="
    text-align: center;
    padding-top: 1.25rem;
    color: #777;
    font-weight: 300;
    font-size: 0.75rem;
    " align="center">
    https://app.patr.cloud/sign-up/confirm?otp={{otp}}&username={{username}}
  </td>
</tr>
<tr>
  <td style="
    padding-top: 1.5rem;
    color: #ffffff;
    letter-spacing: 0.3px;
    line-height: 1.3;
    font-weight: 300;
    font-size: 1rem;
    ">
    This code will expire in
    <strong style="
      text-decoration: none;
      font-weight: 700;
    ">
      {{#if otpExpiry}}{{otpExpiry}}{{else}}10 minutes{{/if}}
    </strong>.
  </td>
</tr>
<tr>
  <td style="
    padding-top: 1rem;
    color: #ffffff;
    letter-spacing: 0.3px;
    line-height: 1.3;
    font-weight: 300;
    font-size: 1rem;
    ">
    If you did not create an account, you can safely ignore this email. If you have any questions or need assistance,
    please contact our support team at
    <a href="mailto:support@patr.cloud" title="Contact Patr support" style="
        color: #f89b41;
        text-decoration: none;
        font-weight: 500;
        font-size: 1rem;
      ">
      support@patr.cloud
    </a>.
  </td>
</tr>
{{/inline}}
{{/container}}