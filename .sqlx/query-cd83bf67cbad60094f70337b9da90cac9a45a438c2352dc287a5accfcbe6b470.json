  "db_name": "PostgreSQL",
  "query": "SELECT user_api_token.token_id AS \"token_id: Uuid\", user_api_token.user_id AS \"user_id: Uuid\", user_api_token.token_hash, user_api_token.token_nbf, user_api_token.token_exp, user_api_token.allowed_ips, user_api_token.revoked, \"user\".* FROM user_api_token INNER JOIN user_login ON user_api_token.token_id = user_login.login_id INNER JOIN \"user\" ON user_api_token.user_id = \"user\".id WHERE user_api_token.token_id = $1 AND user_login.login_type = 'api_token';",
