{
  "db_name": "PostgreSQL",
  "query": "SELECT user_api_token.token_id AS \"token_id: Uuid\", user_api_token.user_id AS \"user_id: Uuid\", user_api_token.token_hash, user_api_token.token_nbf, user_api_token.token_exp, user_api_token.allowed_ips, user_api_token.revoked, \"user\".username, \"user\".first_name, \"user\".last_name, \"user\".created FROM user_api_token INNER JOIN credential ON user_api_token.token_id = credential.credential_id INNER JOIN \"user\" ON user_api_token.user_id = \"user\".id WHERE user_api_token.token_id = $1 AND credential.type = 'api_token';",
