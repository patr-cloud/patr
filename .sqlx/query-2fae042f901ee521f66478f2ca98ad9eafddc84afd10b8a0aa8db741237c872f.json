{
  "db_name": "PostgreSQL",
  "query": "SELECT secret.id, secret.name AS \"name: String\", resource.created AS \"created: OffsetDateTime\", secret.last_updated AS \"last_updated: OffsetDateTime\", COUNT(*) OVER() AS \"total_count!\" FROM secret INNER JOIN resource ON secret.id = resource.id WHERE secret.workspace_id = $1 AND secret.deleted IS NULL AND ($2::TEXT IS NULL OR secret.name ILIKE '%' || $2 || '%') AND ($3::TIMESTAMPTZ IS NULL OR resource.created >= $3) AND ($4::TIMESTAMPTZ IS NULL OR resource.created <= $4) AND ($5::TIMESTAMPTZ IS NULL OR secret.last_updated >= $5) AND ($6::TIMESTAMPTZ IS NULL OR secret.last_updated <= $6) ORDER BY resource.created DESC LIMIT $7 OFFSET $8;",
