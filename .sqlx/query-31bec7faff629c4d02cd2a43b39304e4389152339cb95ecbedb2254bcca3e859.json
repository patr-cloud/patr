  "query": "SELECT secret.id AS \"id: Uuid\", secret.name AS \"name: String\", COUNT(*) OVER() AS \"total_count!\" FROM secret JOIN resource ON secret.id = resource.id WHERE secret.workspace_id = $1 AND secret.deleted IS NULL ORDER BY resource.created DESC LIMIT $2 OFFSET $3;",
