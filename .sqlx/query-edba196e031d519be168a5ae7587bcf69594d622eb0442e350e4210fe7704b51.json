{
  "db_name": "PostgreSQL",
  "query": "WITH updated AS (UPDATE deployment SET status = $1 WHERE id = $2 AND status != $1 AND (($1 = 'errored' AND status = 'deploying') OR ($1 = 'deploying' AND status = 'errored') OR ($1 IN ('deploying', 'errored') AND status = 'running') OR ($1 = 'running' AND status IN ('deploying', 'errored'))) RETURNING status) SELECT COALESCE((SELECT status FROM updated), (SELECT status FROM deployment WHERE id = $2)) AS \"status!: DeploymentStatus\";",
