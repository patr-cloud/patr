  "query": "SELECT managed_url.sub_domain, managed_url.domain_id, managed_url.path, managed_url.deployment_id AS \"deployment_id!\", managed_url.port AS \"port!\", managed_url_custom_hostname.is_active FROM managed_url INNER JOIN managed_url_custom_hostname ON managed_url.sub_domain = managed_url_custom_hostname.sub_domain AND managed_url.domain_id = managed_url_custom_hostname.domain_id INNER JOIN deployment ON deployment.id = managed_url.deployment_id WHERE managed_url.id = $1 AND managed_url.workspace_id = $2 AND managed_url.deleted IS NULL AND managed_url.url_type = 'proxy_to_deployment' AND deployment.runner = $3 AND deployment.deleted IS NULL;",
