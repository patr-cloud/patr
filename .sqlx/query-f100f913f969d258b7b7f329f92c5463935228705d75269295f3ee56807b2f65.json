{
  "db_name": "PostgreSQL",
  "query": "SELECT deployment.id, deployment.name AS \"name: String\", deployment.status, ARRAY_AGG(deployment_environment_variable.name ORDER BY deployment_environment_variable.name) AS \"variables!: Vec<String>\", COUNT(*) OVER() AS \"total_count!\" FROM deployment_environment_variable INNER JOIN deployment ON deployment.id = deployment_environment_variable.deployment_id INNER JOIN RESOURCES_WITH_PERMISSION_FOR_LOGIN_ID($3, $4) AS resource ON deployment.id = resource.id WHERE deployment_environment_variable.secret_id = $1 AND deployment_environment_variable.workspace_id = $2 AND deployment.deleted IS NULL AND ($5::TEXT IS NULL OR deployment.name ILIKE '%' || $5 || '%') AND ($6::DEPLOYMENT_STATUS[] IS NULL OR deployment.status = ANY($6)) GROUP BY deployment.id, deployment.name, deployment.status ORDER BY deployment.name LIMIT $7 OFFSET $8;",
