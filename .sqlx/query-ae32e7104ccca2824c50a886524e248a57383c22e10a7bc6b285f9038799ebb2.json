  "query": "WITH deleted AS (DELETE FROM managed_url WHERE id = $1 RETURNING sub_domain, domain_id, path, deployment_id) SELECT deleted.sub_domain AS \"sub_domain!\", deleted.domain_id, CONCAT(workspace_domain.name, '.', workspace_domain.tld) AS \"domain!\", deleted.path AS \"path!\", deployment.runner AS \"connected_deployment_runner?\" FROM deleted INNER JOIN workspace_domain ON deleted.domain_id = workspace_domain.id LEFT JOIN deployment ON deployment.id = deleted.deployment_id;",
