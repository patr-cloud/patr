{
  "db_name": "PostgreSQL",
  "query": "SELECT managed_url.id, managed_url.sub_domain, managed_url.domain_id, CONCAT(workspace_domain.name, '.', workspace_domain.tld) AS \"domain!\", managed_url.path, managed_url.url_type AS \"url_type: ManagedUrlTypeDiscriminant\", managed_url.deployment_id, managed_url.port, deployment.runner AS \"deployment_runner?\", workspace_domain.is_verified FROM managed_url INNER JOIN workspace_domain ON managed_url.domain_id = workspace_domain.id LEFT JOIN deployment ON deployment.id = managed_url.deployment_id WHERE managed_url.id = $1 AND managed_url.deleted IS NULL AND managed_url.workspace_id = $2;",
