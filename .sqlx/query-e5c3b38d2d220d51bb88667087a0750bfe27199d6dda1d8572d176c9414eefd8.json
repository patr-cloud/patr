{
  "db_name": "PostgreSQL",
  "query": "SELECT workspace_domain.id, CONCAT(name, '.', tld) AS \"name!\", nameserver_type AS \"nameserver_type: DomainNameserverType\", is_verified, last_verified, COUNT(*) OVER() AS \"total_count!\" FROM workspace_domain INNER JOIN RESOURCES_WITH_PERMISSION_FOR_LOGIN_ID($2, $3) AS resource ON workspace_domain.id = resource.id WHERE workspace_id = $1 AND workspace_domain.deleted IS NULL AND ($4::TEXT IS NULL OR CONCAT(name, tld) ILIKE '%' || $4::TEXT || '%') AND ($5::DOMAIN_NAMESERVER_TYPE[] IS NULL OR nameserver_type = ANY($5)) AND ($6::BOOLEAN IS NULL OR is_verified = $6) AND ($7::TIMESTAMPTZ IS NULL OR last_verified >= $7) AND ($8::TIMESTAMPTZ IS NULL OR last_verified <= $8) ORDER BY resource.created DESC LIMIT $9 OFFSET $10;",
