  "query": "SELECT workspace_domain.id, workspace_domain.name, workspace_domain.tld, workspace_domain.workspace_id FROM workspace_domain INNER JOIN resource ON workspace_domain.id = resource.id WHERE workspace_domain.is_verified = FALSE AND workspace_domain.deleted IS NULL AND ((workspace_domain.last_verified IS NOT NULL AND workspace_domain.last_verified < NOW() - INTERVAL '7 days') OR (workspace_domain.last_verified IS NULL AND resource.created < NOW() - INTERVAL '7 days'));",
