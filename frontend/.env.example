VITE_BASE_URL=http://localhost:3001
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloud-only build flag. Unset (or anything other than "true") = self-hosted build.
# Cloud build enables Turnstile, GitHub OAuth, the github-callback routes, and
# defaults the two domains below to patr.cloud / onpatr.cloud.
VITE_CLOUD_MODE=true

# Override the platform base domain (default: patr.cloud when VITE_CLOUD_MODE=true,
# otherwise undefined). Drives `registry.${VITE_BASE_DOMAIN}` for image-name prefixes.
# VITE_BASE_DOMAIN=patr.example.com

# Override the auto-assigned deployment URL domain (default: onpatr.cloud when
# VITE_CLOUD_MODE=true, otherwise undefined). Drives port "Visit URL" links and the
# `ingress.${VITE_DEPLOYMENT_DOMAIN}` hint in the domains UI.
# VITE_DEPLOYMENT_DOMAIN=apps.example.com
