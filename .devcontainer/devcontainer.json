// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust-postgres
{
	"name": "Patr API",
	"dockerComposeFile": "docker-compose.yml",
	"updateRemoteUserUID": true,
	"service": "app",
	"workspaceFolder": "/workspace",
	"customizations": {
		"vscode": {
			"settings": {
				"cSpell.words": [
					"apimachinery",
					"Autoscaler",
					"banzaicloud",
					"BYOC",
					"BYTEA",
					"Citext",
					"DATETIME",
					"DTO",
					"INET",
					"intstr",
					"jsonwebtoken",
					"JWT",
					"kubeconfig",
					"leptos",
					"middlewares",
					"monostate",
					"onpatr",
					"openapi",
					"opentelemetry",
					"optionalable",
					"otlp",
					"padawan",
					"Patr",
					"PKCE",
					"preprocess",
					"Preprocessable",
					"proxied",
					"reauthenticated",
					"reauthentication",
					"regcred",
					"rustfmt",
					"serde",
					"sqlx",
					"Stylesheet",
					"TIMESTAMPTZ",
					"tungstenite",
					"Unsync",
					"wayy",
					"Workspaced",
					"cloudflared"
				],
				"editor.formatOnSave": true,
				"editor.rulers": [
					100
				],
				"evenBetterToml.formatter.reorderKeys": true,
				"evenBetterToml.formatter.alignEntries": true,
				"evenBetterToml.formatter.reorderInlineTables": true,
				"evenBetterToml.formatter.reorderArrays": false,
				"evenBetterToml.formatter.columnWidth": 200,
				"files.watcherExclude": {
					"**/target/**": true,
					"./devcontainer/volume/**": true
				},
				"rust-analyzer.cargo.targetDir": "./target/rust-analyzer",
				"rust-analyzer.check.noDefaultFeatures": true,
				"rust-analyzer.check.workspace": false,
				"rust-analyzer.rustfmt.extraArgs": [
					"+nightly"
				],
				"rust-analyzer.showUnlinkedFileNotification": false,
				// runs rust analyzer in different folder so that cargo build won't wait to start compiling
				"tailwindCSS.includeLanguages": {
					"rust": "html"
				}
			},
			"extensions": [
				"vadimcn.vscode-lldb",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"usernamehw.errorlens",
				"citreae535.sparse-crates",
				"GitHub.vscode-pull-request-github",
				"naumovs.color-highlight",
				"streetsidesoftware.code-spell-checker",
				"patr-cloud.patr-theme",
				"bradlc.vscode-tailwindcss",
				"DioxusLabs.dioxus"
			]
		}
	},
	"forwardPorts": [
		3000,
		3001,
		4000,
		"logs:3100",
		"tracing:16686",
		"grafana:3000"
	],
	"postAttachCommand": "sudo chown :docker /var/run/docker.sock || exit 0"
}